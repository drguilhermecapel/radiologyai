# Copie para .env e preencha. NUNCA commite o .env.
# Nenhum valor default inseguro é fornecido de propósito: a aplicação deve
# falhar alto se um segredo obrigatório estiver ausente.

# --- Segurança ---
JWT_SECRET=
ENCRYPTION_KEY=
JWT_EXPIRATION_HOURS=24

# --- Banco ---
DB_HOST=medai-db
DB_USERNAME=
DB_PASSWORD=

# --- Caminhos (relativos ou absolutos; sem caminhos hardcoded no código) ---
MEDAI_DATA_DIR=./data
MEDAI_MODELS_DIR=./models
MEDAI_LOGS_DIR=./logs

# --- PACS (opcional) ---
PACS_AE_TITLE=MEDAI_SCU
PACS_HOST=localhost
PACS_PORT=11112

# --- Alertas (opcional) ---
CLINICAL_ALERT_EMAIL=
CLINICAL_ALERT_WEBHOOK=
SLACK_WEBHOOK=
PAGERDUTY_KEY=
