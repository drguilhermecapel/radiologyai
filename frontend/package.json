{
  "name": "radiologyai-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Interface web de pesquisa do RadiologyAI (uso exclusivo em pesquisa; não é dispositivo médico).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "gen:api": "openapi-typescript ../docs/OPENAPI_SPEC.yaml -o src/api/schema.d.ts",
    "check:api": "openapi-typescript ../docs/OPENAPI_SPEC.yaml -o /tmp/radiologyai-schema-check.d.ts && diff -q /tmp/radiologyai-schema-check.d.ts src/api/schema.d.ts",
    "test:e2e": "node ../tests/e2e/run-e2e.mjs"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "openapi-typescript-helpers": "0.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
